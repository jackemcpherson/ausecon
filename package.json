{
  "name": "ausecon-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/test && tsc -p packages/cli && tsc -p packages/testkit && tsc -p packages/rba-index && tsc -p tsconfig.node.json",
    "test": "vp test",
    "build": "vp run -r build",
    "docs:check": "rumdl check --deny-config-warnings . && vale --no-global .",
    "rba:index": "bun packages/rba-index/main.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@effect/vitest": "4.0.6",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4"
}
